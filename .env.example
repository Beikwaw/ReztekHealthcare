# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and must NEVER be committed (contains secrets).

# === Firebase (client) – from Firebase Console > Project settings > General ===
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# === Server-only (never exposed to the client) ===
# Required for consultation AI summary.
OPENAI_API_KEY=

# Optional: email consultation summary + invoice PDFs to patient (Resend).
RESEND_API_KEY=
# Use verified domain: "DR WC MKHONZA HEALTH PRACTICE <noreply@drwcmkhonzaportal.co.za>"
CONSULTATION_EMAIL_FROM=

# === Firebase Admin (server) ===
# Local: save the service account key as firebase-service-account.json in project root (.gitignore).
# Vercel: set FIREBASE_SERVICE_ACCOUNT_JSON to the full JSON key (one line) in Project Settings > Environment Variables.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# === One-time seed: real staff users (Clerk, Admin, Doctor) ===
# Set these only when running: node scripts/seed-real-users.js
# Remove or leave blank after seeding. Never commit .env.local.
# SEED_CLERK_PASSWORD=
# SEED_ADMIN_PASSWORD=
# SEED_DR_PASSWORD=
